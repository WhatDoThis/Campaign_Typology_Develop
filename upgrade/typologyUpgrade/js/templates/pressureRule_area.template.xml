-->
<typologyRule _operation="insertOrUpdate" _key="@name"
               active="true" forceOnPrepareMessage="true" validity="0"
               label="[LGU] SMS/MMS Type 2 (template)" messageType="101"
               name="RLSmsMmsType2" order="20" ruleType="businessRanking"
               schema="nms:recipient" xtkschema="nms:typologyRule">
  <contextFilter>
    <where>
      <condition expr="@LGU_TARGET_TYPE_M_NO" operator="=" value="2"/>
    </where>
  </contextFilter>
  <businessRanking activeForecast="true" boxingUnit="0"
                   periodRanking="7d" threshold="2" thresholdType="0">
